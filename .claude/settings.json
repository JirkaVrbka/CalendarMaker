{
  "$comment": "Hook-wiring template. Copy into the target project's .claude/settings.json and REMOVE any block whose hook the user did not install. Hooks are Node .mjs scripts run via `node` in EXEC FORM (command + args) so they work identically on Linux, macOS, and Windows and handle paths with spaces. ${CLAUDE_PROJECT_DIR} is expanded by Claude Code on all platforms. Requires Node.js (always present with Claude Code).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-bash.mjs"] }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-files.mjs"] },
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/alignment-gate.mjs"] }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/scan-secrets.mjs"] },
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/auto-format.mjs"] }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-check.mjs"] }
        ]
      }
    ]
  }
}
